# Storefront (Next.js) — baked in at build time for static export
# Leave empty for demo checkout / admin-banner mode.
NEXT_PUBLIC_PAYMOB_API_BASE=https://nile-packs-api.<your-subdomain>.workers.dev
NEXT_PUBLIC_ADMIN_API_BASE=https://nile-packs-api.<your-subdomain>.workers.dev

# --- Cloudflare Worker secrets / vars (see workers/paymob/wrangler.toml + ADMIN.md) ---
# Set secrets with: npx wrangler secret put <NAME> -c workers/paymob/wrangler.toml
# NEVER put real passwords here.
PAYMOB_SECRET_KEY=sk_test_or_live_from_paymob_dashboard
PAYMOB_PUBLIC_KEY=pk_test_or_live_from_paymob_dashboard
PAYMOB_HMAC_SECRET=hmac_secret_from_paymob_dashboard
PAYMOB_INTEGRATION_ID_CARD=1234567
APP_URL=https://tarekhegazy77-svg.github.io/nile-packs
ADMIN_OWNER_EMAIL=you@example.com
ADMIN_OWNER_PASSWORD=use_wrangler_secret_put_not_this_file
SESSION_SECRET=long_random_string
